# Copy this file to ".env" and adjust if needed. Never commit ".env".
# Every value below is intentionally empty - fill in what you need.

# ---- Server ----
# "development" (default) or "production". In production the app refuses to
# start unless FRONTEND_URL uses https.
NODE_ENV=

# Port the API listens on. Example: 4000
PORT=

# URL of the frontend (used for CORS). Must be an https:// URL in production.
FRONTEND_URL=

# How many reverse proxies (Nginx, Render, Heroku, ...) stand in front of the
# API, so client IPs are read from X-Forwarded-For. Options: a number of trusted
# hops (e.g. 1), "true" to trust all proxies (Render/Heroku), or a
# comma-separated list of proxy IPs/subnets. Leave empty to ignore proxy
# headers entirely (plain development setup).
TRUST_PROXY=

# ---- Database ----
# SQLite file. Path is relative to the "prisma" folder. Example: file:./dev.db
DATABASE_URL=

# ---- Sessions ----
# How many days a login lasts (default 7)
SESSION_TTL_DAYS=

# ---- First admin account (used only by: npm run db:seed) ----
# Admins cannot register through the website. Fill these in, run the seed, then
# you may blank the password again. Password: 8+ chars with a letter and a number.
# Never ship the well-known default "Admin12345" - the app refuses to start in
# production if ADMIN_PASSWORD is set to it.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- OAuth (optional Google / Facebook sign-in) ----
# Leave empty to keep that provider disabled. Register these callback URLs with each provider.
# Example callback paths: /api/auth/oauth/google/callback and /api/auth/oauth/facebook/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=
FACEBOOK_GRAPH_API_VERSION=
