# Copy this file to ".env" and adjust if needed. Never commit ".env".

# ---- Server ----
NODE_ENV=development
PORT=4000

# URL of the frontend (used for CORS)
FRONTEND_URL=http://localhost:5173

# ---- Database ----
# SQLite file. Path is relative to the "prisma" folder -> backend/prisma/dev.db
DATABASE_URL="file:./dev.db"

# ---- Sessions ----
# How many days a login lasts (default 7)
SESSION_TTL_DAYS=7

# ---- First admin account (used only by: npm run db:seed) ----
# Admins cannot register through the website. Fill these in, run the seed, then
# you may blank the password again. Password: 8+ chars with a letter and a number.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- OAuth (optional Google / Facebook sign-in) ----
# Leave empty to keep that provider disabled. Register these callback URLs with each provider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/oauth/google/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:4000/api/auth/oauth/facebook/callback
FACEBOOK_GRAPH_API_VERSION=v22.0
